<script>
'use strict';
const $=id=>document.getElementById(id);let token='';let data={leads:[],bookings:[],calendar:[],times:[],window:{}};
const LEAD_STATUS={new:'Nouveau',contacted:'Contacté',qualified:'Qualifié',converted:'Converti',lost:'Perdu'};
const BOOK_STATUS={pending:'À confirmer',confirmed:'Confirmé',cancelled:'Annulé'};const BOOK_PILL={pending:'warn',confirmed:'ok',cancelled:'bad'};
const Q_LABELS={q1:'1. Niveau d’expérience',q2:'2. Marché préféré',q3:'3. Plus grande difficulté',q4:'4. Objectif principal',q5:'5. Temps par semaine',q6:'6. Budget envisagé',q7:'7. Plan de trading écrit',q8:'8. Type d’accompagnement'};
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function digits(v){return String(v||'').replace(/\D/g,'')}
function toast(msg,bad){const e=document.createElement('div');e.className='toast'+(bad?' bad':'');e.textContent=msg;document.body.appendChild(e);setTimeout(()=>e.remove(),3000)}
function fmtDate(iso){try{return new Date(iso+'T12:00:00').toLocaleDateString('fr-FR',{weekday:'short',day:'2-digit',month:'short'})}catch(e){return iso}}
function fmtDateTime(iso){try{return new Date(iso).toLocaleString('fr-FR',{dateStyle:'short',timeStyle:'short'})}catch(e){return iso||'—'}}
async function api(path,opts){const o=Object.assign({headers:{}},opts||{});o.headers=Object.assign({Authorization:'Bearer '+token},o.headers);if(o.body)o.headers['Content-Type']='application/json';const r=await fetch(path,o);if(r.status===401){logout();throw new Error('Session expirée')}const x=await r.json().catch(()=>({}));if(!r.ok)throw Object.assign(new Error(x.error||'Erreur'),{code:x.code,payload:x});return x}
function logout(){fetch('/api/admin/logout',{method:'POST',headers:{Authorization:'Bearer '+token}}).catch(()=>{});token='';try{sessionStorage.removeItem('adm')}catch(e){}location.href='/admin'}
function todayKey(){try{return new Intl.DateTimeFormat('en-CA',{timeZone:data.timezone||'America/Port-au-Prince',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())}catch(e){return new Date().toISOString().slice(0,10)}}
function updateClock(){const now=new Date();$('topDate').textContent=now.toLocaleDateString('fr-FR',{weekday:'long',day:'2-digit',month:'long',year:'numeric'});$('topTime').textContent=now.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})}setInterval(updateClock,1000);updateClock();
async function load(){data=await api('/api/admin/data');const active=data.bookings.filter(b=>b.status!=='cancelled');$('kLeads').textContent=data.leads.length;$('kNew').textContent=data.leads.filter(l=>l.status==='new').length;$('kQualified').textContent=data.leads.filter(l=>l.status==='qualified').length;$('kBookings').textContent=active.length;const today=todayKey();$('todayCount').textContent=active.filter(b=>b.date===today).length;$('kFree').textContent=data.calendar.reduce((n,d)=>n+d.slots.filter(s=>s.available).length,0);$('envLine').textContent='Stockage : '+data.engine+' · Fuseau : '+data.timezone;renderOverview();renderLeads();renderBookings();renderCalendar();detectNewBookings()}
function bookingOf(id){return data.bookings.find(b=>b.leadId===id&&b.status!=='cancelled')||null}
function initials(name){return String(name||'??').split(/\s+/).slice(0,2).map(x=>x[0]).join('').toUpperCase()}
function scoreClass(s){s=Number(s||0);return s>=3?'good':s>=2?'mid':'low'}
function renderLeads(){const q=($('search').value||$('globalSearch').value||'').toLowerCase().trim(),st=$('filterStatus').value;const rows=data.leads.filter(l=>(!st||l.status===st)&&(!q||[l.name,l.age,l.email,l.phone,l.countryName,l.countryCode,l.dialCode,l.language,l.q1,l.q2,l.q3,l.q4,l.q5,l.q6,l.q7,l.q8,l.notes].join(' ').toLowerCase().includes(q)));$('leadsTable').innerHTML=!rows.length?'<div style="padding:30px;text-align:center" class="muted">Aucun candidat ne correspond.</div>':'<table class="table"><thead><tr><th>Candidat</th><th>Âge</th><th>Pays</th><th>Langue</th><th>Score</th><th>Candidature</th><th>Rendez-vous</th><th>Statut</th><th></th></tr></thead><tbody>'+rows.map(l=>{const b=bookingOf(l.id),sc=Number(l.score||0);return '<tr><td><div class="candidate"><div class="miniAvatar">'+initials(l.name)+'</div><div><b>'+esc(l.name)+'</b><span>'+esc(l.email)+'</span></div></div></td><td><span class="pill">'+esc(l.age||'—')+'</span></td><td><span class="pill">'+(l.countryName?esc(l.countryName)+' '+(l.dialCode?'('+esc(l.dialCode)+')':''):'—')+'</span></td><td><span class="pill">'+esc(l.language||'—')+'</span></td><td><span class="score '+scoreClass(sc)+'">'+sc+'/3</span></td><td class="small muted">'+fmtDateTime(l.createdAt)+'</td><td>'+(b?'<b>'+fmtDate(b.date)+'</b><br><span class="small muted">'+esc(b.time)+'</span>':'<span class="muted small">Aucun</span>')+'</td><td><select data-lead-status="'+l.id+'" style="background:#101a27;color:#dce4ef;border:1px solid #233247;border-radius:8px;padding:6px;font-size:11px">'+Object.keys(LEAD_STATUS).map(k=>'<option value="'+k+'"'+(l.status===k?' selected':'')+'>'+LEAD_STATUS[k]+'</option>').join('')+'</select></td><td><button class="ghost" data-open-lead="'+l.id+'">Détails</button></td></tr>'}).join('')+'</tbody></table>'}
function renderBookings(){const show=$('showCancelled').checked;const rows=data.bookings.filter(b=>show||b.status!=='cancelled').sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time));$('bookingsTable').innerHTML=!rows.length?'<div style="padding:30px;text-align:center" class="muted">Aucun rendez-vous.</div>':'<table class="table"><thead><tr><th>Date</th><th>Heure</th><th>Candidat</th><th>Âge</th><th>Pays</th><th>Langue</th><th>Score</th><th>Statut</th><th>Actions</th></tr></thead><tbody>'+rows.map(b=>{const l=data.leads.find(v=>v.id===b.leadId)||{},sc=Number(l.score||0);return '<tr><td><b>'+fmtDate(b.date)+'</b><br><span class="small muted">'+esc(b.date)+'</span></td><td><b>'+esc(b.time)+'</b></td><td><div class="candidate"><div class="miniAvatar">'+initials(l.name)+'</div><div><b>'+esc(l.name||'—')+'</b><span>'+esc(l.phone||l.email||'')+'</span></div></div></td><td><span class="pill">'+esc(l.age||'—')+'</span></td><td><span class="pill">'+(l.countryName?esc(l.countryName)+' '+(l.dialCode?'('+esc(l.dialCode)+')':''):'—')+'</span></td><td><span class="pill">'+esc(l.language||'—')+'</span></td><td><span class="score '+scoreClass(sc)+'">'+sc+'/3</span></td><td><span class="pill '+BOOK_PILL[b.status]+'">'+BOOK_STATUS[b.status]+'</span></td><td><div class="actions"><button class="ghost" data-open-lead="'+b.leadId+'">Détails</button>'+(b.status!=='confirmed'?'<button class="okBtn" data-book-status="'+b.id+'" data-to="confirmed">Confirmer</button>':'')+'<button class="ghost" data-reschedule="'+b.id+'">Déplacer</button>'+(b.status!=='cancelled'?'<button class="dangerBtn" data-book-status="'+b.id+'" data-to="cancelled">Annuler</button>':'<button class="ghost" data-book-status="'+b.id+'" data-to="pending">Rétablir</button>')+'</div></td></tr>'}).join('')+'</tbody></table>'}
function renderCalendar(){ $('calendar').innerHTML=data.calendar.map(day=>'<div class="calDay"><div class="calDayHead">'+fmtDate(day.date)+' <span style="float:right;color:#77869c">'+day.slots.filter(s=>s.available).length+' libre(s)</span></div>'+day.slots.map(s=>{if(s.past&&!s.taken)return '<div class="slot past"><span>'+esc(s.time)+'</span><span>passé</span></div>';if(!s.taken)return '<div class="slot free"><span>'+esc(s.time)+'</span><span>libre</span></div>';const b=data.bookings.find(v=>v.date===day.date&&v.time===s.time&&v.status!=='cancelled');const l=b?(data.leads.find(v=>v.id===b.leadId)||{}):{};return '<div class="slot busy"><span>'+esc(s.time)+'</span>'+(b?'<button class="ghost" style="padding:3px 6px" data-open-lead="'+b.leadId+'">'+esc((l.name||'Réservé').split(' ')[0])+'</button>':'<b>réservé</b>')+'</div>'}).join('')+'</div>').join('') }
function miniCalendar(){const base=new Date();const y=base.getFullYear(),m=base.getMonth();const first=new Date(y,m,1).getDay();const offset=(first+6)%7;const days=new Date(y,m+1,0).getDate();let h='<div class="month"><b>'+base.toLocaleDateString('fr-FR',{month:'long',year:'numeric'})+'</b><span class="muted small">● rendez-vous</span></div><div class="week"><span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span></div><div class="days">';for(let i=0;i<offset;i++)h+='<div class="day empty"></div>';for(let d=1;d<=days;d++){const key=y+'-'+String(m+1).padStart(2,'0')+'-'+String(d).padStart(2,'0');const busy=data.bookings.some(b=>b.date===key&&b.status!=='cancelled');const today=d===base.getDate();h+='<div class="day '+(today?'today ':'')+(busy?'dot':'')+'">'+d+'</div>'}return h+'</div>'}
function renderOverview(){const active=data.bookings.filter(b=>b.status!=='cancelled'),today=todayKey();const upcoming=active.filter(b=>b.date>=today).sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time)).slice(0,5);$('upcomingAppointments').innerHTML=upcoming.length?upcoming.map(b=>{const l=data.leads.find(v=>v.id===b.leadId)||{};return '<div class="appt"><div class="time">'+esc(b.time)+'</div><div><b>'+esc(l.name||'Candidat')+'</b><span>'+fmtDate(b.date)+' · '+esc(l.language||'')+'</span></div><span class="pill '+BOOK_PILL[b.status]+'">'+BOOK_STATUS[b.status]+'</span></div>'}).join(''):'<div class="muted" style="padding:24px 0;text-align:center">Aucun rendez-vous à venir.</div>';const rows=data.leads.slice().sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt))).slice(0,6);$('recentLeads').innerHTML='<table class="table"><thead><tr><th>Candidat</th><th>Score</th><th>Rendez-vous</th><th>Statut</th><th></th></tr></thead><tbody>'+rows.map(l=>{const b=bookingOf(l.id),sc=Number(l.score||0);return '<tr><td><div class="candidate"><div class="miniAvatar">'+initials(l.name)+'</div><div><b>'+esc(l.name)+'</b><span>'+esc(l.email)+'</span></div></div></td><td><span class="score '+scoreClass(sc)+'">'+sc+'/3</span></td><td>'+(b?'<b>'+fmtDate(b.date)+'</b><br><span class="small muted">'+esc(b.time)+'</span>':'<span class="muted small">Aucun</span>')+'</td><td><span class="pill '+(l.status==='converted'||l.status==='qualified'?'ok':l.status==='lost'?'bad':l.status==='new'?'info':'warn')+'">'+(LEAD_STATUS[l.status]||l.status)+'</span></td><td><button class="ghost" data-open-lead="'+l.id+'">Voir</button></td></tr>'}).join('')+'</tbody></table>';miniCalendar();drawChart()}
function drawChart(){const c=$('activityChart'),ctx=c.getContext('2d'),dpr=devicePixelRatio||1,w=c.clientWidth,h=c.clientHeight;c.width=w*dpr;c.height=h*dpr;ctx.scale(dpr,dpr);ctx.clearRect(0,0,w,h);const days=[];for(let i=6;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);days.push(d.toISOString().slice(0,10))}const lead=days.map(k=>data.leads.filter(l=>String(l.createdAt||'').slice(0,10)===k).length),book=days.map(k=>data.bookings.filter(b=>String(b.createdAt||'').slice(0,10)===k).length);const max=Math.max(4,...lead,...book);ctx.font='10px system-ui';for(let i=0;i<5;i++){const y=22+i*(h-48)/4;ctx.strokeStyle='rgba(255,255,255,.06)';ctx.beginPath();ctx.moveTo(32,y);ctx.lineTo(w-8,y);ctx.stroke();ctx.fillStyle='#5f6c80';ctx.fillText(String(Math.round(max-(max*i/4))),4,y+3)}function line(vals,stroke){ctx.beginPath();vals.forEach((v,i)=>{const x=34+i*(w-48)/6,y=20+(max-v)*(h-48)/max;i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.strokeStyle=stroke;ctx.lineWidth=2;ctx.stroke();vals.forEach((v,i)=>{const x=34+i*(w-48)/6,y=20+(max-v)*(h-48)/max;ctx.fillStyle=stroke;ctx.beginPath();ctx.arc(x,y,3,0,Math.PI*2);ctx.fill()})}line(lead,'#e7b84b');line(book,'#4da3ff');ctx.fillStyle='#68758a';days.forEach((k,i)=>ctx.fillText(k.slice(5).replace('-','/'),28+i*(w-48)/6,h-8))}
function openModal(html){$('modalPanel').innerHTML=html;$('modal').classList.remove('hidden')}function closeModal(){$('modal').classList.add('hidden');$('modalPanel').innerHTML=''}
