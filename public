    const hay=(iso+' '+code+' '+Object.values(names).join(' ')).toLowerCase();
    return !q||hay.includes(q);
  });
  const previous=codeEl.value||'HT';
  if(!matches.length){optionsEl.innerHTML='<div class="small" style="padding:12px">Aucun pays trouvé</div>';return;}
  optionsEl.innerHTML=matches.map(([iso,flag,names,code])=>'<button type="button" class="country-option" data-iso="'+iso+'" role="option">'+flag+' '+names[lang]+' '+code+'</button>').join('');
  const activeIso=matches.some(c=>c[0]===previous)?previous:matches[0][0];
  codeEl.value=activeIso;
  const active=countries.find(c=>c[0]===activeIso)||countries[0];
  if($('countryName'))$('countryName').value=active[2][lang]||active[2]['Kreyòl'];
  if($('dialCode'))$('dialCode').value=active[3];
  if(selectedEl)selectedEl.textContent=active[1]+' '+active[2][lang]+' '+active[3];
  optionsEl.querySelectorAll('.country-option').forEach(btn=>{
    if(btn.dataset.iso===activeIso)btn.classList.add('active');
