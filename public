button.sm{padding:6px 11px;font-size:13px;border-radius:8px}
.hidden{display:none !important}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.row>.grow{flex:1;min-width:180px}
.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:18px}
.kpi{background:var(--card);border-radius:var(--radius);padding:16px 18px;box-shadow:var(--shadow)}
.kpi .n{font-size:26px;font-weight:800;margin-top:4px}
.tabs{display:flex;gap:6px;margin-bottom:18px;flex-wrap:wrap}
.tab{padding:9px 16px;border-radius:999px;background:#e8ecf4;cursor:pointer;font-weight:600;font-size:14px;border:0;color:var(--ink);width:auto}
.tab.on{background:var(--brand);color:#fff}
.tablewrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:820px}
th{text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);padding:10px;border-bottom:2px solid var(--line)}
td{padding:12px 10px;border-bottom:1px solid var(--line);vertical-align:top}
tr:hover td{background:#fafbfe}
.pill{display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;background:#eef1f7;color:var(--muted)}
.pill.ok{background:var(--okbg);color:var(--ok)}
.pill.warn{background:var(--warnbg);color:var(--warn)}
.pill.bad{background:var(--badbg);color:var(--bad)}
.pill.info{background:var(--infobg);color:var(--info)}
.score{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;font-weight:800;background:#eef1f7}
.score.s2{background:var(--warnbg);color:var(--warn)}
.score.s3{background:var(--okbg);color:var(--ok)}
.link{color:var(--info);text-decoration:none;font-weight:600;cursor:pointer}
.wa{color:var(--ok);text-decoration:none;font-weight:600}
.cal{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px}
.day{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff}
.day header{padding:9px 12px;background:#f2f5fa;font-weight:700;font-size:13px;border-bottom:1px solid var(--line)}
.day header .c{float:right;font-weight:600;color:var(--muted)}
.slot{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:7px 12px;font-size:13px;border-bottom:1px solid #f1f3f8}
.slot:last-child{border-bottom:0}
.slot.free{color:var(--ok)}
.slot.busy{background:var(--infobg)}
.slot.past{color:#b6bdcc;text-decoration:line-through}
.slot b{font-weight:700}
.modal{position:fixed;inset:0;background:rgba(15,22,36,.55);display:flex;align-items:flex-start;justify-content:center;padding:28px 16px;overflow:auto;z-index:50}
.modal .panel{background:#fff;border-radius:16px;max-width:760px;width:100%;padding:26px;box-shadow:0 24px 60px rgba(0,0,0,.25)}
.answers{display:grid;grid-template-columns:150px 1fr;gap:8px 16px;font-size:14px}
.answers dt{color:var(--muted);font-weight:600}
.answers dd{margin:0}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:26px;background:var(--brand);color:#fff;padding:12px 20px;border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.25);z-index:100;font-weight:600}
.toast.bad{background:var(--bad)}
.banner{padding:12px 16px;border-radius:10px;background:var(--warnbg);color:var(--warn);font-weight:600;margin-bottom:16px}
@media(max-width:980px){.kpis{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.kpis{grid-template-columns:1fr}.wrap{padding:18px 14px 60px}}

.shell{display:grid;grid-template-columns:230px 1fr;gap:20px;align-items:start}.sidebar{position:sticky;top:20px;background:#111a2d;color:#fff;border-radius:18px;padding:18px;box-shadow:var(--shadow)}.brand{padding:8px 10px 20px;border-bottom:1px solid rgba(255,255,255,.1);margin-bottom:12px}.brand strong{font-size:18px}.brand span{display:block;color:#aeb8cb;font-size:12px;margin-top:3px}.nav{display:flex;flex-direction:column;gap:7px}.nav button{width:100%;text-align:left;background:transparent;color:#cbd4e5;padding:11px 12px;border-radius:10px}.nav button:hover,.nav button.active{background:#24304a;color:#fff}.main{min-width:0}.topbar{background:#fff;border-radius:16px;padding:16px 18px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow);margin-bottom:18px}.topbar .grow{flex:1}.iconbtn{position:relative}.badge{position:absolute;top:-5px;right:-5px;background:#d92d20;color:#fff;border-radius:999px;min-width:18px;height:18px;font-size:10px;display:flex;align-items:center;justify-content:center}.overview-grid{display:grid;grid-template-columns:1.35fr .85fr;gap:18px}.appt{display:flex;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}.appt:last-child{border-bottom:0}.time{font-weight:800;font-size:18px;min-width:58px}.apptmain{display:flex;flex-direction:column;flex:1}.apptmain span{font-size:12px;color:var(--muted)}.notif{display:flex;gap:10px;padding:11px 0;border-bottom:1px solid var(--line)}.notif:last-child{border-bottom:0}.dot{width:9px;height:9px;border-radius:50%;background:#2a4d8f;margin-top:6px;flex:0 0 auto}.empty{padding:24px 10px;color:var(--muted);text-align:center}.section-head{display:flex;align-items:center;gap:10px;margin-bottom:12px}.section-head h2{margin:0;flex:1}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px}.quick .box{margin:0}.mini{font-size:12px;color:var(--muted)}
@media(max-width:900px){.shell{grid-template-columns:1fr}.sidebar{position:static}.nav{flex-direction:row;overflow:auto}.nav button{white-space:nowrap;width:auto}.overview-grid{grid-template-columns:1fr}}
</style></head><body><div class="wrap"><div class="box" style="max-width:440px;margin:70px auto"><h1>Dashboard privé</h1><p class="muted small">Coach Leonidas — Empire des Spatiates</p><div style="margin-top:22px"><label class="small muted">Utilisateur</label><input id="user" value="admin" autocomplete="username"></div><div style="margin-top:14px"><label class="small muted">Mot de passe</label><input id="pass" type="password" autocomplete="current-password"></div><button id="loginBtn" style="margin-top:18px;width:100%">Se connecter</button><p id="loginErr" class="small hidden" style="color:var(--bad);margin-top:10px"></p><p class="small muted" style="margin-top:14px">Votre espace est privé. Après connexion, vous serez redirigé vers votre dashboard.</p></div></div><script>
async function login(){const btn=document.getElementById('loginBtn');btn.disabled=true;document.getElementById('loginErr').classList.add('hidden');try{const r=await fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:document.getElementById('user').value,password:document.getElementById('pass').value})});const x=await r.json().catch(()=>({}));if(!r.ok){document.getElementById('loginErr').textContent=x.code==='rate_limited'?'Trop de tentatives. Patientez quelques minutes.':'Identifiants incorrects.';document.getElementById('loginErr').classList.remove('hidden');return}try{sessionStorage.setItem('adm',x.token)}catch(e){}window.location.href='/dashboard';}finally{btn.disabled=false}}document.getElementById('loginBtn').onclick=login;document.getElementById('pass').addEventListener('keydown',e=>{if(e.key==='Enter')login()});try{if(sessionStorage.getItem('adm'))window.location.href='/dashboard'}catch(e){}
</script></body></html>
